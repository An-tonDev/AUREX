// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id  Int @id @default(autoincrement())
  email String  @unique
  passwordHash String
  phoneNumber String @unique
  kycStatus KycStatus @default(PENDING)
  tier Tier @default(TIER_1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallets wallet[]
  sessions Session[]
}

enum KycStatus{
       VERIFIED
       PENDING
       REJECTED
}

enum Tier{
  TIER_1
  TIER_2
  TIER_3
}

model Transaction{
  id Int @id @default(autoincrement())
  sender Wallet @relation("sentTransactions",fields:[senderWalletId],references:[id])
  senderWalletId Int
  receiver Wallet @relation("receivedTransactions" ,fields:[receiverWalletId],references:[id])
  receiverWalletId Int
  amount Int
  currency String
  reference String @unique
  type Transactiontype
  status TransactionStatus @default(PENDING)
  description String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ledgerEntries LedgerEntry[]
}
enum Transactiontype{
 DEPOSIT
 WITHDRAWAL
 TRANSFER
 AIRTIME
 BILL_PAYMENT
}

enum  TransactionStatus{
   PENDING 
   SUCCESS
   FAILED
}

model Wallet{
  id Int @id @default(autoincrement())
  walletNo String @unique
  balance Int
  currency String
  user User @relation(fields:[userId],references:[id])
  userId Int
  status WalletStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  sentTransactions Transaction[] @relation("sentTransactions")
  receivedTransactions Transaction[] @relation("receivedTransactions")
  ledgerEntries LedgerEntry[]
}

enum WalletStatus{
  BLOCKED
  ACTIVE
}


model Session{
  id Int @id @default(autoincrement())
  user User @relation(fields:[userId],references:[id])
  userId Int
  refreshTokenHash String
  deviceName String
  ipAddress String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model LedgerEntry{
  id Int @id @default(autoincrement())
  transaction Transaction @relation(fields:[transactionId],references:[id])
  transactionId Int
  wallet Wallet @relation(fields:[walletId], references:[id])
  walletId Int
  type LedgerEntryType
  currrency String
  amount Int
  createdAt DateTime @default(now())
}

enum LedgerEntryType{
  DEBIT
  CREDIT
}
